{
  "name": "e2e",
  "version": "0.0.0-dev",
  "description": "End-to-end tests for the notebook extension",
  "scripts": {
    "build:extension": "node ../build/src/build-extension.ts",
    "e2e": "npm run build:extension && test-with-playwright --only-extension=../extension --test-path=.",
    "e2e:electron": "node ../build/src/test-electron.ts",
    "e2e:headless": "npm run build:extension && test-with-playwright --only-extension=../extension --test-path=. --headless",
    "e2e:bundled": "test-with-playwright --test-path=bundled --headless",
    "e2e:bundled:electron": "test-with-playwright --test-path=electron --electron --electron-version=v0.115.10 --filter=notebook-defaults.ts --timeout=60000"
  },
  "type": "module",
  "author": "LVCE Editor",
  "license": "MIT",
  "devDependencies": {
    "@lvce-editor/test-with-playwright": "22.36.3",
    "@playwright/test": "^1.62.1"
  }
}
