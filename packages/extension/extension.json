{
  "id": "builtin.notebook",
  "name": "Notebook",
  "workerName": "Notebook Worker",
  "description": "View Jupyter notebooks in LVCE Editor",
  "repository": "https://github.com/lvce-editor/notebook",
  "browser": "dist/notebookMain.js",
  "isolated": true,
  "contentSecurityPolicy": [
    "default-src 'none'",
    "style-src 'self'",
    "script-src 'self'"
  ],
  "categories": ["Other"],
  "activation": ["onView:notebook.views.notebook", "onCommand:notebook.show"],
  "commands": [
    {
      "id": "notebook.show",
      "label": "Notebook: Show"
    }
  ],
  "views": [
    {
      "css": "media/notebook.css",
      "displayName": "Notebook",
      "id": "notebook.views.notebook",
      "title": "Notebook",
      "icon": "media/notebook.svg",
      "kind": "virtualDom",
      "preferredLocation": "preview"
    }
  ]
}
